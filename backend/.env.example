# Database
DATABASE_URL="postgresql://user:password@localhost:5432/studybuddy?schema=public"

# JWT
JWT_SECRET="your-secure-jwt-secret-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:54321"

# AI Provider - Anthropic (Claude)
ANTHROPIC_API_KEY=""

# AI Provider - OpenAI (GPT)
OPENAI_API_KEY=""

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10
